---
import Icone from "./Icone.astro";
import iconeCalendario from "../../assets/icones/calendario.svg?raw";
import simbolo from "../../assets/simbolo.svg?raw";
import type { ItemRecurso } from "../../data/recursos";

/** Card de sermão/recurso: miniatura (thumbnail real ou placeholder) + título + data. */
interface Props {
  item: ItemRecurso & { thumb?: string };
  /** Proporção da miniatura: "video" (16:9, YouTube) ou "square" (1:1, Spotify) */
  aspecto?: "video" | "square";
}
const { item, aspecto = "video" } = Astro.props;
const externo = item.href.startsWith("http");
const aspectoClasse = aspecto === "square" ? "aspect-square" : "aspect-video";
---

<a
  href={item.href}
  target={externo ? "_blank" : undefined}
  rel={externo ? "noopener noreferrer" : undefined}
  class="group flex flex-col gap-5"
>
  <div
    class:list={[
      "relative overflow-hidden rounded-xl bg-areia/60",
      aspectoClasse,
    ]}
  >
    {
      item.thumb ? (
        <img
          src={item.thumb}
          alt={item.titulo}
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-bege/40 transition-transform duration-500 group-hover:scale-105">
          <Icone svg={simbolo} class="size-16" />
        </div>
      )
    }
  </div>
  <div class="flex flex-col gap-3">
    <p
      class="font-sans text-base font-semibold transition-colors group-hover:text-sangue"
    >
      {item.titulo}
    </p>
    {
      item.data && (
        <div class="flex items-center gap-1.5 opacity-50">
          <Icone svg={iconeCalendario} class="size-[18px] text-bege" />
          <span class="font-sans text-sm font-medium">{item.data}</span>
        </div>
      )
    }
  </div>
</a>
