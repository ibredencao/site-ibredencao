---
/**
 * Renderiza um SVG importado com ?raw, inline, herdando a cor do texto.
 * O tamanho é controlado pela classe (padrão: 24px, igual ao Figma).
 *
 * IDs internos (clipPath, mask, gradients) são escopados por instância para
 * evitar colisão quando o mesmo SVG aparece mais de uma vez na página
 * (ex.: o logo no Header, no Footer e no menu mobile).
 */
interface Props {
  svg: string;
  class?: string;
}

const { svg, class: className = "size-6" } = Astro.props;

const g = globalThis as { __iconeSeq?: number };
g.__iconeSeq = (g.__iconeSeq ?? 0) + 1;
const sufixo = `i${g.__iconeSeq}`;

const svgEscopado = svg
  .replace(/id="([^"]+)"/g, `id="$1-${sufixo}"`)
  .replace(/url\(#([^)]+)\)/g, `url(#$1-${sufixo})`)
  .replace(/((?:xlink:)?href)="#([^"]+)"/g, `$1="#$2-${sufixo}"`);
---

<span
  class:list={[
    "inline-flex shrink-0 items-center justify-center [&>svg]:h-full [&>svg]:w-auto",
    className,
  ]}
  aria-hidden="true"
  set:html={svgEscopado}
/>
