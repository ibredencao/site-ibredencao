---
import Icone from "./Icone.astro";
import iconeLetra from "../../assets/icones/letra.svg?raw";
// Stand-in para a cifra (trocar se o designer criar um ícone próprio)
import iconeCifra from "../../assets/icones/musica.svg?raw";
import iconePartitura from "../../assets/icones/partitura.svg?raw";
import iconeOuvir from "../../assets/icones/ouvir.svg?raw";
import type { Musica } from "../../data/recursos";

/** Card de música (texto): título + autor/versão + links Letra/Partitura/Ouvir. */
interface Props {
  musica: Musica;
}
const { musica } = Astro.props;

const acoes = [
  { rotulo: "Letra", icone: iconeLetra, href: musica.letra },
  { rotulo: "Cifra", icone: iconeCifra, href: musica.cifra },
  { rotulo: "Partitura", icone: iconePartitura, href: musica.partitura },
  { rotulo: "Ouvir", icone: iconeOuvir, href: musica.ouvir },
].filter((a) => a.href);
---

<article
  class="flex flex-col justify-between gap-6 rounded-2xl border border-preto/15 p-10 duration-300 hover:border-preto/40"
>
  <div class="flex flex-col">
    <h3 class="mb-0 font-display text-2xl text-preto">{musica.titulo}</h3>
    <div class="flex flex-col font-sans text-lg opacity-70">
      <p>{musica.autor}</p>
      {musica.versao && <p>{musica.versao}</p>}
    </div>
  </div>

  {
    acoes.length > 0 && (
      <div class="flex flex-wrap gap-x-6 gap-y-3">
        {acoes.map((acao) => (
          <a
            href={acao.href}
            class="flex items-center gap-1 font-ui text-base font-medium text-sangue transition-opacity hover:opacity-70"
          >
            <Icone svg={acao.icone} class="size-[18px]" />
            {acao.rotulo}
          </a>
        ))}
      </div>
    )
  }
</article>
