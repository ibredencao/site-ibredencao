---
/**
 * Botão padrão do site (Figma: componentes "Btn", "Btn outline" e "Btn Inline").
 * - solid: fundo sangue, texto branco
 * - outline: borda sangue, texto sangue
 * - inline: só texto + seta, para links discretos ("Ver rota...")
 * `icone="seta"` acrescenta a seta (›) também nos botões solid/outline
 * (ex.: "Ler mais", "Ver mais no Youtube").
 */
interface Props {
  href: string;
  variant?: "solid" | "outline" | "inline" | "inverted";
  icone?: "seta";
  /** Cor do texto no variant inline (padrão: sangue; no rodapé usa-se areia) */
  class?: string;
}

const { href, variant = "solid", icone, class: className = "" } = Astro.props;

const base =
  "font-ui flex-wrap gap-1 text-[14px] lg:text-[15px] font-semibold transition-colors duration-300";
const variants = {
  solid:
    "flex md:inline-flex justify-center bg-sangue text-branco hover:bg-sangue-escuro rounded-lg px-8 py-4",
  outline:
    "flex md:inline-flex justify-center border-sangue text-sangue hover:bg-sangue hover:text-branco rounded-lg border px-8 py-4",
  inline: "inline-flex mr-auto text-sangue hover:opacity-75",
  inverted:
    "flex md:inline-flex justify-center bg-areia text-sangue hover:bg-areia-escuro rounded-lg px-8 py-4",
};

const mostrarSeta = variant === "inline" || icone === "seta";

// Links externos (WhatsApp, rota no Google Maps, Youtube...) abrem em nova
// aba; internos e mailto: seguem na mesma.
const externo = /^https?:\/\//.test(href);
---

<a
  href={href}
  target={externo ? "_blank" : undefined}
  rel={externo ? "noopener noreferrer" : undefined}
  class:list={[base, variants[variant], className]}
>
  <slot />
  {
    mostrarSeta && (
      <svg
        class:list={["size-6 shrink-0", icone === "seta" && "text-areia"]}
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M9 6l6 6-6 6"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</a>
