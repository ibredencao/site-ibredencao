---
/**
 * Botão padrão do site (Figma: componentes "Btn", "Btn outline" e "Btn Inline").
 * - solid: fundo sangue, texto branco
 * - outline: borda sangue, texto sangue
 * - inline: só texto + seta, para links discretos ("Ler mais", "Ver rota...")
 */
interface Props {
  href: string;
  variant?: "solid" | "outline" | "inline";
  /** Cor do texto no variant inline (padrão: sangue; no rodapé usa-se areia) */
  class?: string;
}

const { href, variant = "solid", class: className = "" } = Astro.props;

const base =
  "font-ui inline-flex items-center gap-1 text-[15px] font-semibold transition-colors duration-300";
const variants = {
  solid: "bg-sangue text-branco hover:bg-sangue-escuro rounded-lg px-8 py-6",
  outline:
    "border-sangue text-sangue hover:bg-sangue/10 rounded-lg border px-8 py-6",
  inline: "text-sangue hover:opacity-75",
};
---

<a href={href} class:list={[base, variants[variant], className]}>
  <slot />
  {
    variant === "inline" && (
      <svg class="size-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M9 6l6 6-6 6"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</a>
