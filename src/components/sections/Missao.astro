---
import { missao } from "../../data/conteudo";

/**
 * Missão como declaração tipográfica: rótulo pequeno em areia + frase em
 * Collier, à esquerda no grid, sobre a faixa marrom.
 * O id fica para deep links.
 */
---

<section
  id="missao"
  aria-label="Missão"
  class="scroll-mt-0 bg-bege text-branco"
>
  {
    /* Bloco centralizado na faixa (o texto segue alinhado à esquerda),
      com medida larga para a frase não se esticar em muitas linhas */
  }
  <div class="mx-auto max-w-[1585px] px-6 py-16 lg:px-10 lg:py-24" data-reveal>
    <div class="mx-auto flex max-w-4xl flex-col gap-6 lg:gap-8">
      <p
        class="font-sans text-[13px] font-medium tracking-[0.3em] text-areia uppercase"
      >
        Nossa missão
      </p>
      <p
        class="font-display text-[clamp(1.5rem,2.5vw,2.25rem)] leading-[1.35] font-light"
      >
        {missao}
      </p>
    </div>
  </div>
</section>
