---
import Secao from "../ui/Secao.astro";
import MoldemImagem from "../ui/MoldemImagem.astro";
import Icone from "../ui/Icone.astro";
import iconeIgreja from "../../assets/icones/igreja.svg?raw";
import iconeCasa from "../../assets/icones/casa.svg?raw";
import { contato } from "../../data/navegacao";

/**
 * Seção Agenda + Fale Conosco. Reutilizada na Home, Nossa História e Recursos.
 * Layout: imagem à esquerda, agenda à direita (empilha no mobile).
 */
const itens = [
  { icone: iconeIgreja, titulo: "Culto Público", horario: "Domingo, às 10h" },
  {
    icone: iconeCasa,
    titulo: "Pequenos Grupos",
    horario: "Terças e quintas, às 19h30",
  },
];
---

<Secao id="agenda" fundo="branco">
  <div
    class="grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-10"
    data-reveal
  >
    <MoldemImagem proporcao="1/1" class="w-full lg:col-span-5 lg:col-start-2" />

    <div class="flex flex-col gap-12 lg:col-span-3 lg:col-start-8 lg:gap-16">
      <h2 class="titulo-secao">Agenda</h2>

      <ul class="flex flex-col gap-6">
        {
          itens.map((item, i) => (
            <li>
              {i > 0 && <hr class="mb-6 border-preto/10" />}
              <div class="flex items-center gap-4">
                <Icone svg={item.icone} class="size-12 text-bege" />
                <div class="flex flex-col gap-2">
                  <p class="font-sans text-2xl font-medium">{item.titulo}</p>
                  <p class="font-sans text-lg tracking-tight text-bege">
                    {item.horario}
                  </p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-6">
          <p class="font-sans text-2xl font-medium">Fale Conosco</p>
          <p class="max-w-md font-sans text-lg opacity-80">
            Entre em contato conosco via instagram ou e-mail para tirar dúvidas
            e receber mais informações.
          </p>
        </div>
        <div class="flex flex-wrap gap-6">
          <a
            href={contato.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-sangue px-8 py-4 font-ui text-[15px] font-semibold text-sangue transition-colors hover:bg-sangue/10"
          >
            Instagram
          </a>
          <a
            href={`mailto:${contato.email}`}
            class="rounded-lg border border-sangue px-8 py-4 font-ui text-[15px] font-semibold text-sangue transition-colors hover:bg-sangue/10"
          >
            E-mail
          </a>
        </div>
      </div>
    </div>
  </div>
</Secao>
