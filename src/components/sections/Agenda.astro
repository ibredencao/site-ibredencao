---
import Secao from "../ui/Secao.astro";
import MoldemImagem from "../ui/MoldemImagem.astro";
import fotoAgenda from "../../assets/agenda.jpg";
import Btn from "../ui/Btn.astro";

/**
 * Seção Agenda + Fale Conosco. Reutilizada na Home, Nossa História e Recursos.
 * Layout: imagem à esquerda, agenda à direita (empilha no mobile).
 */
const itens = [
  { titulo: "Culto Público", horario: "Domingo, às 10h" },
  {
    titulo: "Pequenos Grupos",
    horario: "Terças e quintas, às 19h30",
    descricao:
      "Os Pequenos Grupos acontecem semanalmente e oferecem um espaço para comunhão, oração e estudo da Palavra de Deus, fortalecendo nossos relacionamentos e nossa caminhada cristã.",
  },
];
---

<Secao id="agenda" fundo="branco">
  <div
    class="grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-10"
    data-reveal
  >
    <div
      class="flex flex-col gap-12 lg:col-span-5 lg:col-start-7 lg:row-start-1 lg:gap-8 xl:col-span-4 xl:col-start-8"
    >
      <h2 class="titulo-secao">Agenda</h2>

      <ul class="flex flex-col gap-4">
        {
          itens.map((item, i) => (
            <li>
              {i > 0 && <hr class="mb-4 border-preto/10" />}
              <div class="flex gap-4">
                <div class="flex flex-col">
                  <h3 class="font-sans text-xl font-medium">{item.titulo}</h3>
                  <p class="font-sans text-lg leading-snug text-bege">
                    {item.horario}
                  </p>
                  {item.descricao && (
                    <p class="mt-2 font-sans text-base leading-snug opacity-70">
                      {item.descricao}
                    </p>
                  )}
                </div>
              </div>
            </li>
          ))
        }
      </ul>
      <Btn href="#onde-estamos" class="w-fit">Entrar em contato</Btn>
    </div>

    <MoldemImagem
      src={fotoAgenda}
      alt="Pessoa sentada segurando o boletim do culto da Igreja Batista Redenção"
      proporcao="1/1"
      class="w-full lg:col-span-6 lg:row-start-1 xl:col-span-5 xl:col-start-2"
    />
  </div>
</Secao>
