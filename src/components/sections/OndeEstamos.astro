---
import Secao from "../ui/Secao.astro";
import Btn from "../ui/Btn.astro";
import { contato } from "../../data/navegacao";

/**
 * Seção "Onde estamos": endereço + mapa. Reutilizada na Home, Nossa História
 * e Recursos. O mapa é MapLibre GL + tiles da OpenFreeMap com tema nas cores
 * da marca (src/scripts/mapa.ts + src/lib/mapaEstilo.ts), sem chave de API.
 *
 * Grid do site: 12 colunas, gutter 40px (gap-x-10) sobre o container de 1585px.
 * Responsivo:
 *  - ≥1536px (2xl, padrão): texto col 3–5, mapa col 6–10 (centralizado, como no Figma).
 *  - 1024–1535px (lg): texto col 2–5 e mapa col 6–11 — ambos maiores e simétricos,
 *    para o título "Onde estamos" não quebrar nessa faixa.
 *  - <1024px: empilhado.
 */
const { endereco } = contato;
---

<Secao id="onde-estamos" fundo="creme">
  <div class="grid items-center gap-x-10 gap-y-12 lg:grid-cols-12" data-reveal>
    <div class="flex flex-col gap-8 lg:col-span-4 lg:col-start-2">
      <h2 class="titulo-secao">Onde estamos</h2>
      <address class="flex flex-col text-lg not-italic">
        <span class="font-sans font-semibold">{endereco.nome}</span>
        <div class="flex flex-col font-sans">
          <span>{endereco.rua}</span>
          <span>{endereco.bairro}</span>
          <span>{endereco.cidade}</span>
        </div>
      </address>
      <Btn href={contato.rotaGoogleMaps} variant="inline" class="text-sangue">
        Ver rota no Google Maps
      </Btn>
      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-6">
          <p class="font-sans text-2xl font-medium">Fale Conosco</p>
          <p class="max-w-md font-sans text-lg leading-snug opacity-80">
            Entre em contato conosco via WhatsApp ou e-mail para tirar dúvidas e
            receber informações.
          </p>
        </div>
        <div class="flex flex-wrap gap-6">
          <Btn href={contato.whatsapp.href} variant="outline"> WhatsApp </Btn>
          <Btn href={contato.email} variant="outline"> E-mail </Btn>
        </div>
      </div>
    </div>

    {
      /* O tamanho vem SÓ deste wrapper (aspect-square); o mapa é absolute
         inset-0 para o ResizeObserver do MapLibre nunca realimentar a altura
         do layout (loop de crescimento infinito ao redimensionar o canvas). */
    }
    <div
      class="relative aspect-square w-full overflow-hidden rounded-xl border border-areia/60 lg:col-span-6 lg:col-start-6"
    >
      <div
        id="mapa-localizacao"
        class="bg-areia/40"
        data-lat={endereco.coordenadas.lat}
        data-lng={endereco.coordenadas.lng}
        aria-label="Mapa — localização da Igreja Batista Redenção"
      >
        <noscript>
          <p class="p-6 font-sans">
            Ative o JavaScript para ver o mapa, ou
            <a href={contato.rotaGoogleMaps} class="text-sangue underline">
              abra a localização no Google Maps</a
            >.
          </p>
        </noscript>
      </div>
    </div>
  </div>
</Secao>

<script src="../../scripts/mapa.ts"></script>

<style>
  /* Ancorado no id (sem @layer): o CSS do MapLibre aplica
     .maplibregl-map { position: relative } fora de camadas, o que venceria a
     utility `absolute` do Tailwind (que vive em @layer utilities). Absoluto
     dentro do wrapper aspect-square, o mapa nunca dita a altura do layout —
     era isso que causava o crescimento infinito via ResizeObserver. */
  #mapa-localizacao {
    position: absolute;
    inset: 0;
  }
</style>
