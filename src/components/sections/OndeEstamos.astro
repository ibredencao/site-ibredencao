---
import Secao from "../ui/Secao.astro";
import Btn from "../ui/Btn.astro";
import { contato } from "../../data/navegacao";

/**
 * Seção "Onde estamos": endereço + mapa. Reutilizada na Home, Nossa História
 * e Recursos. O mapa é um embed do Google Maps (sem necessidade de chave).
 *
 * Grid do site: 12 colunas, gutter 40px (gap-x-10) sobre o container de 1585px.
 * Responsivo:
 *  - ≥1536px (2xl, padrão): texto col 3–5, mapa col 6–10 (centralizado, como no Figma).
 *  - 1024–1535px (lg): texto col 2–5 e mapa col 6–11 — ambos maiores e simétricos,
 *    para o título "Onde estamos" não quebrar nessa faixa.
 *  - <1024px: empilhado.
 */
const { endereco } = contato;
const mapaEmbed = `https://www.google.com/maps?q=${encodeURIComponent(
  `${endereco.nome}, ${endereco.rua}, ${endereco.bairro}, ${endereco.cidade}`,
)}&output=embed`;
---

<Secao id="onde-estamos" fundo="creme">
  <div class="grid items-center gap-x-10 gap-y-12 lg:grid-cols-12" data-reveal>
    <div
      class="flex flex-col gap-8 lg:col-span-4 lg:col-start-2"
    >
      <h2 class="titulo-secao">Onde estamos</h2>
      <address class="flex flex-col text-lg not-italic">
        <span class="font-sans font-semibold">{endereco.nome}</span>
        <div class="flex flex-col font-sans">
          <span>{endereco.rua}</span>
          <span>{endereco.bairro}</span>
          <span>{endereco.cidade}</span>
        </div>
      </address>
      <Btn href={contato.rotaGoogleMaps} variant="inline" class="text-sangue">
        Ver rota no Google Maps
      </Btn>
      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-6">
          <p class="font-sans text-2xl font-medium">Fale Conosco</p>
          <p class="max-w-md font-sans text-lg leading-snug opacity-80">
            Entre em contato conosco via WhatsApp ou e-mail para tirar dúvidas
            e receber informações.
          </p>
        </div>
        <div class="flex flex-wrap gap-6">
          <Btn href={contato.whatsapp.href} variant="outline">
            WhatsApp
          </Btn>
          <Btn href={contato.email} variant="outline">
            E-mail
          </Btn>
        </div>
      </div>
    </div>

    <div
      class="overflow-hidden rounded-xl border border-areia/60 lg:col-span-6 lg:col-start-6"
    >
      <iframe
        src={mapaEmbed}
        title="Mapa — localização da Igreja Batista Redenção"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        class="aspect-square w-full"></iframe>
    </div>
  </div>
</Secao>
