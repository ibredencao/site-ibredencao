---
import { Image } from "astro:assets";
import Btn from "../ui/Btn.astro";
import heroCulto from "../../assets/hero.jpg";
import { heroTitulo, heroReferencia, missao } from "../../data/conteudo";

/**
 * Hero da Home: título + CTAs sobre fundo claro, foto do culto que avança
 * sobre a faixa marrom, e a seção Missão (texto branco sobre marrom).
 * A foto ocupa metade sobre o creme e metade sobre o marrom (como no Figma).
 */
---

<section class="relative bg-branco pt-30 lg:pt-[136px] lg:pt-[168px]">
  <div
    class="flex flex-col gap-10 px-6 text-center lg:mx-auto lg:max-w-[1585px] lg:items-center lg:px-10"
  >
    <div class="flex flex-col items-center gap-4">
      {
        /* max-w-xl força a quebra em duas linhas ("Ao Senhor pertence / a
          salvação"), com o text-balance equilibrando a divisão */
      }
      <h1 class="titulo-hero text-[2.7rem] md:text-5xl lg:text-6xl">
        {heroTitulo}
      </h1>
      <p class="font-sans text-[13px] font-medium text-preto/50 uppercase">
        {heroReferencia}
      </p>
    </div>
    <div class="flex justify-center gap-5">
      <Btn href="/#onde-estamos" class="w-full px-4! lg:w-auto lg:px-8!"
        >Onde estamos</Btn
      >
      <Btn
        href="/confissao-de-fe"
        variant="outline"
        class="w-full px-4! lg:w-auto lg:px-8!">Confissão de fé</Btn
      >
    </div>
  </div>

  {/* Zona de sobreposição: foto sobre a faixa marrom */}
  <div class="relative mt-14 lg:mt-20">
    <div class="absolute inset-x-0 top-[55%] bottom-0 bg-bege"></div>
    <div class="relative mx-auto max-w-[1585px] px-6 lg:px-10">
      <Image
        src={heroCulto}
        alt="Congregação reunida durante um culto na Igreja Batista Redenção"
        class="aspect-square w-full rounded-xl object-cover lg:aspect-[1584/784]"
        widths={[640, 1024, 1440, 1600]}
        sizes="(max-width: 1600px) 100vw, 1585px"
        loading="eager"
      />
    </div>
  </div>
</section>

{
  /* Sem título visível: o aria-label preserva o nome da região e o <p>
    absorve o layout do antigo wrapper. O id fica para deep links. */
}
<section
  id="missao"
  aria-label="Missão"
  class="scroll-mt-0 bg-bege pb-20 text-branco lg:pb-20"
>
  <p
    class="px-6 pt-12 font-sans text-lg leading-snug lg:mx-auto lg:max-w-2xl lg:pt-16 lg:text-center lg:text-2xl"
    data-reveal
  >
    {missao}
  </p>
</section>
