---
import { Image } from "astro:assets";
import Btn from "../ui/Btn.astro";
import heroCulto from "../../assets/hero.jpg";
import { heroTitulo, heroReferencia, missao } from "../../data/conteudo";

/**
 * Hero da Home: título + CTAs sobre fundo claro, foto do culto que avança
 * sobre a faixa marrom, e a seção Missão (declaração em Collier sobre
 * marrom, com as palavras acendendo conforme o scroll).
 * A foto ocupa metade sobre o creme e metade sobre o marrom (como no Figma).
 */

// Uma palavra por <span> para o efeito de acender (o espaço vai dentro do
// span, como texto — some no fim de linha e mantém as quebras naturais).
const palavrasMissao = missao.split(" ");
---

<section class="relative bg-branco pt-30 lg:pt-[168px]">
  <div
    class="flex flex-col gap-10 px-6 text-center lg:mx-auto lg:max-w-[1585px] lg:items-center lg:px-10"
  >
    <div class="flex flex-col items-center gap-4">
      {
        /* max-w-* força a quebra em duas linhas; o text-balance do
          .titulo-hero equilibra a divisão */
      }
      <h1
        class="titulo-hero entrada-hero max-w-sm text-[2.7rem] uppercase md:max-w-lg md:text-5xl lg:max-w-2xl lg:text-6xl"
      >
        {heroTitulo}
      </h1>
      <p
        class="entrada-hero font-sans text-[13px] font-medium text-preto/50 uppercase [--atraso-entrada:80ms]"
      >
        {heroReferencia}
      </p>
    </div>
    <div
      class="entrada-hero flex justify-center gap-5 [--atraso-entrada:160ms]"
    >
      <Btn href="/#onde-estamos" class="w-full px-4! lg:w-auto lg:px-8!"
        >Onde estamos</Btn
      >
      <Btn
        href="/confissao-de-fe"
        variant="outline"
        class="w-full px-4! lg:w-auto lg:px-8!">Confissão de fé</Btn
      >
    </div>
  </div>

  {/* Zona de sobreposição: foto sobre a faixa marrom */}
  <div class="relative mt-14 lg:mt-20">
    <div class="absolute inset-x-0 top-[55%] bottom-0 bg-bege"></div>
    <div class="relative mx-auto max-w-[1585px] px-6 lg:px-10">
      <Image
        src={heroCulto}
        alt="Congregação reunida durante um culto na Igreja Batista Redenção"
        class="aspect-square w-full rounded-xl object-cover lg:aspect-[1584/784]"
        widths={[640, 1024, 1440, 1600]}
        sizes="(max-width: 1600px) 100vw, 1585px"
        loading="eager"
      />
    </div>
  </div>
</section>

{
  /* Missão como declaração tipográfica (referência: churchcenteredmissions.org):
    rótulo pequeno em areia + frase grande em Collier, à esquerda no grid,
    com as palavras acendendo conforme o scroll. Leitores de tela recebem a
    frase inteira (sr-only); os spans palavra-a-palavra ficam aria-hidden.
    O id fica para deep links. */
}
<section
  id="missao"
  aria-label="Missão"
  class="scroll-mt-0 bg-bege text-branco"
>
  <div
    class="mx-auto grid max-w-[1585px] gap-y-6 px-6 py-16 lg:grid-cols-12 lg:gap-x-10 lg:gap-y-8 lg:px-10 lg:py-24"
  >
    <p
      class="font-sans text-[13px] font-medium tracking-[0.3em] text-areia uppercase lg:col-span-8 lg:col-start-3"
      data-reveal
    >
      Nossa missão
    </p>
    <p
      class="max-w-[36ch] font-display text-[clamp(1.75rem,3vw,2.75rem)] leading-[1.28] font-light lg:col-span-9 lg:col-start-3"
    >
      <span class="sr-only">{missao}</span>
      <span aria-hidden="true" data-acende
        >{palavrasMissao.map((palavra) => <span>{palavra + " "}</span>)}</span
      >
    </p>
  </div>
</section>

<script>
  // Acende as palavras da missão conforme a frase atravessa o viewport:
  // progresso 0 com o topo da frase a 88% da tela, 1 com o fundo a 55%.
  // Só cor (paint de texto) e throttle por rAF — sem custo de layout.
  function initMissaoAcende() {
    const bloco = document.querySelector<HTMLElement>("[data-acende]");
    if (!bloco) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const palavras = [...bloco.querySelectorAll<HTMLElement>(":scope > span")];
    let agendado = false;

    const atualizar = () => {
      agendado = false;
      const r = bloco.getBoundingClientRect();
      const vh = window.innerHeight;
      const percorrido = 0.88 * vh - r.top;
      const total = 0.33 * vh + r.height;
      const progresso = Math.min(1, Math.max(0, percorrido / total));
      const acesas = Math.round(progresso * palavras.length);
      palavras.forEach((p, i) => p.classList.toggle("acesa", i < acesas));
    };

    const aoRolar = () => {
      if (agendado) return;
      agendado = true;
      requestAnimationFrame(atualizar);
    };

    atualizar();
    window.addEventListener("scroll", aoRolar, { passive: true });
    window.addEventListener("resize", aoRolar, { passive: true });
    document.addEventListener(
      "astro:before-swap",
      () => {
        window.removeEventListener("scroll", aoRolar);
        window.removeEventListener("resize", aoRolar);
      },
      { once: true },
    );
  }
  document.addEventListener("astro:page-load", initMissaoAcende);
</script>
