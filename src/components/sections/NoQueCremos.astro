---
import Secao from "../ui/Secao.astro";
import Btn from "../ui/Btn.astro";
import MoldemImagem from "../ui/MoldemImagem.astro";
import { noQueCremos } from "../../data/conteudo";

/** Resumo "No que cremos" na Home: texto à esquerda, imagem à direita. */
---

<Secao fundo="branco">
  <div
    class="grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-10"
    data-reveal
  >
    <div class="flex flex-col gap-8 lg:col-span-6 xl:col-start-2 xl:col-span-4">
      <h2 class="titulo-secao">No que cremos</h2>
      <div
        class="flex flex-col gap-4 font-sans text-base leading-snug opacity-80"
      >
        {noQueCremos.map((paragrafo) => <p>{paragrafo}</p>)}
      </div>
      <Btn href="/confissao-de-fe" icone="seta" class="w-fit">Ler mais</Btn>
    </div>

    <MoldemImagem proporcao="1/1" class="w-full xl:col-start-7 xl:col-span-5 lg:col-span-6" />
  </div>
</Secao>
