---
import Secao from "../ui/Secao.astro";
import Btn from "../ui/Btn.astro";
import MoldemImagem from "../ui/MoldemImagem.astro";
import fotoNoQueCremos from "../../assets/no-que-cremos.jpg";
import { noQueCremos } from "../../data/conteudo";

/** Resumo "No que cremos" na Home: texto à esquerda, imagem à direita. */
---

<Secao fundo="branco">
  {/* Cascata sutil: o bloco de texto entra e a foto o segue (60ms) */}
  <div
    class="grid items-center gap-y-12 lg:grid-cols-12 lg:gap-x-10"
    data-reveal-grupo
  >
    <div class="flex flex-col gap-8 lg:col-span-6 xl:col-span-4 xl:col-start-2">
      <h2 class="titulo-secao">No que cremos</h2>
      {
        /* Frase de abertura em Collier (escala entre o título e o corpo) +
          apoio no padrão de leitura do site */
      }
      <div class="flex flex-col gap-5">
        <p
          class="font-display text-[clamp(1.4rem,2.2vw,1.9rem)] leading-snug text-balance"
        >
          {noQueCremos.destaque}
        </p>
        <p class="max-w-md font-sans text-lg leading-relaxed opacity-80">
          {noQueCremos.apoio}
        </p>
      </div>
      <Btn href="/confissao-de-fe" icone="seta" class="w-fit">
        Conheça nossa Confissão de Fé
      </Btn>
    </div>

    <MoldemImagem
      src={fotoNoQueCremos}
      alt="Irmãos com as mãos erguidas em oração durante o culto"
      proporcao="1/1"
      class="w-full lg:col-span-6 xl:col-span-5 xl:col-start-7"
    />
  </div>
</Secao>
