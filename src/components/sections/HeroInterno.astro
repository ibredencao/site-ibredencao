---
/**
 * Hero das páginas internas: faixa vinho com o grafismo (SVG do Figma em
 * public/grafismo-hero.svg, cor embutida), título (Collier) e subtítulo/versículo.
 * Texto em areia. O header sobre este hero deve usar temaHeader="escuro".
 */
interface Props {
  titulo: string;
  subtitulo?: string;
}
const { titulo, subtitulo } = Astro.props;

// Divide o título em DUAS linhas no ponto mais equilibrado (títulos curtos,
// até 10 caracteres ou uma palavra, ficam em linha única). Cada linha vira
// inseparável (nbsp) para nunca degradar em três linhas.
function dividirTitulo(t: string): string[] {
  const palavras = t.split(" ");
  if (palavras.length < 2 || t.length <= 10) return [t];
  let melhor = 1;
  let melhorDiff = Infinity;
  for (let i = 1; i < palavras.length; i++) {
    const a = palavras.slice(0, i).join(" ").length;
    const b = palavras.slice(i).join(" ").length;
    if (Math.abs(a - b) < melhorDiff) {
      melhorDiff = Math.abs(a - b);
      melhor = i;
    }
  }
  return [
    palavras.slice(0, melhor).join("\u00A0"),
    palavras.slice(melhor).join("\u00A0"),
  ];
}
const linhasTitulo = dividirTitulo(titulo);
---

<section class="relative overflow-hidden bg-sangue text-areia">
  {/* Grafismo decorativo — SVG do Figma, largura total, no topo */}
  <img
    src="/grafismo-hero.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute top-1/2 left-1/2 w-[150%] max-w-none -translate-x-1/2 -translate-y-1/2 lg:w-full lg:opacity-50"
  />

  {
    /* Mobile: texto alinhado à esquerda e título maior;
      a partir de lg, centrado como no design original. */
  }
  <div
    class="relative mx-auto flex max-w-3xl flex-col gap-6 px-6 pt-40 pb-20 text-left lg:max-w-5xl lg:items-center lg:pt-48 lg:pb-28 lg:text-center"
  >
    <h1
      class="entrada-hero font-display text-[3.75rem] leading-[1.1] font-light md:text-[clamp(3rem,7.5vw,5.75rem)]"
    >
      {linhasTitulo[0]}{linhasTitulo[1] && <br class="lg:hidden" />}{
        linhasTitulo[1] ? ` ${linhasTitulo[1]}` : ""
      }
    </h1>
    {
      subtitulo && (
        <p class="entrada-hero max-w-xl font-sans text-lg opacity-80 [--atraso-entrada:80ms]">
          {subtitulo}
        </p>
      )
    }
  </div>
</section>
