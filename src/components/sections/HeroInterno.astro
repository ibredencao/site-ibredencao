---
/**
 * Hero das páginas internas: faixa vinho com o grafismo (SVG do Figma em
 * public/grafismo-hero.svg, cor embutida), título (Collier) e subtítulo/versículo.
 * Texto em areia. O header sobre este hero deve usar temaHeader="escuro".
 */
interface Props {
  titulo: string;
  subtitulo?: string;
}
const { titulo, subtitulo } = Astro.props;
---

<section class="relative overflow-hidden bg-sangue text-areia">
  {/* Grafismo decorativo — SVG do Figma, largura total, no topo */}
  <img
    src="/grafismo-hero.svg"
    alt=""
    aria-hidden="true"
    class="pointer-events-none absolute top-1/2 left-1/2 w-[150%] max-w-none -translate-x-1/2 -translate-y-1/2 opacity-50 lg:w-full"
  />

  <div
    class="relative mx-auto flex max-w-3xl flex-col items-center gap-6 px-6 pt-40 pb-20 text-center lg:pt-48 lg:pb-28"
  >
    <h1
      class="font-display text-[clamp(2.75rem,7vw,5rem)] leading-none font-light"
    >
      {titulo}
    </h1>
    {
      subtitulo && (
        <p class="max-w-xl font-sans text-lg opacity-80">{subtitulo}</p>
      )
    }
  </div>
</section>
