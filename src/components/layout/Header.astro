---
import logo from "../../assets/logo.svg?raw";
import simbolo from "../../assets/simbolo.svg?raw";
import Icone from "../ui/Icone.astro";
import NavColuna from "./NavColuna.astro";
import { navEsquerda, navDireita } from "../../data/navegacao";

/**
 * Dois headers:
 *  1. #header-topo — sobre o hero (transparente), rola JUNTO com a página e some.
 *     tema "claro" (texto escuro, Home) ou "escuro" (texto areia, hero vinho).
 *  2. #header-fixo — compacto (só o símbolo), fixo no topo. Fica escondido e
 *     desliza para dentro depois que o header do topo desaparece com o scroll.
 *     Sempre sólido (fundo branco, texto escuro), sem sombra.
 */
interface Props {
  tema?: "claro" | "escuro";
}
const { tema = "claro" } = Astro.props;

// Sobre o hero vinho (tema escuro) o hover é branco; nos demais casos, vermelho.
const hoverTopo = tema === "escuro" ? "branco" : "sangue";

const navClasse =
  "mx-auto flex max-w-[1585px] items-center gap-10 px-6 py-4 lg:px-10";
const toggleClasse =
  "js-menu-toggle ml-auto flex size-10 cursor-pointer flex-col items-center justify-center lg:hidden";
---

{/* Header do topo — rola junto com a página (apenas no desktop) */}
<header
  id="header-topo"
  data-tema={tema}
  class="absolute inset-x-0 top-0 z-40 mt-10 hidden lg:block"
>
  <nav class={navClasse} aria-label="Navegação principal">
    <NavColuna
      itens={navEsquerda}
      alinhamento="justify-start"
      hover={hoverTopo}
    />

    <a
      href="/"
      class="order-first flex shrink-0 items-center lg:order-none"
      aria-label="Igreja Batista Redenção — página inicial"
    >
      <Icone svg={logo} class="h-9" />
    </a>

    <NavColuna itens={navDireita} alinhamento="justify-end" hover={hoverTopo} />

    <button
      type="button"
      class={toggleClasse}
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <span class="linha-menu"></span>
      <span class="linha-menu"></span>
      <span class="linha-menu"></span>
    </button>
  </nav>
</header>

{/* Header fixo compacto — aparece deslizando após o header do topo sumir */}
{
  /* z-70: acima do menu mobile (z-60), para o logo e o botão hambúrguer→X
    continuarem visíveis e clicáveis com o menu aberto. */
}
<header
  id="header-fixo"
  class="fixed inset-x-0 top-0 z-70 border-b border-b-black/10 bg-branco text-preto"
>
  <nav class={navClasse} aria-label="Navegação principal">
    <NavColuna itens={navEsquerda} alinhamento="justify-start" hover="sangue" />

    {/* Logo completo no mobile; só o símbolo no desktop */}
    <a
      href="/"
      class="order-first flex shrink-0 items-center lg:order-none"
      aria-label="Igreja Batista Redenção — página inicial"
    >
      <span class="lg:hidden">
        <Icone svg={logo} class="h-9" />
      </span>
      <span class="hidden lg:block">
        <Icone svg={simbolo} class="size-9" />
      </span>
    </a>

    <NavColuna itens={navDireita} alinhamento="justify-end" hover="sangue" />

    <button
      type="button"
      class={toggleClasse}
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <span class="linha-menu"></span>
      <span class="linha-menu"></span>
      <span class="linha-menu"></span>
    </button>
  </nav>
</header>

<style>
  #header-topo {
    color: var(--color-preto);
  }
  #header-topo[data-tema="escuro"] {
    color: var(--color-areia);
  }

  /* Header fixo: escondido acima da viewport; desliza para dentro quando visível.
     Ancorado no id (especificidade alta) para vencer as utilities de forma estável. */
  #header-fixo {
    transform: translateY(-100%);
    opacity: 0;
    transition:
      transform 0.3s ease-out,
      opacity 0.3s ease-out;
  }
  #header-fixo[data-visivel="true"] {
    transform: translateY(0);
    opacity: 1;
  }

  /* No mobile só existe o header fixo — sempre visível, sem esconder/deslizar. */
  @media (max-width: 1023px) {
    #header-fixo {
      transform: none;
      opacity: 1;
    }
  }

  /* Botão do menu (hambúrguer → X): 3 linhas; ao abrir (aria-expanded, setado
     pelo script do MenuMobile), as linhas de fora giram e se encontram no
     centro enquanto a do meio some. Centros distam 7px (2px linha + 5px gap). */
  .js-menu-toggle {
    gap: 5px;
  }
  .linha-menu {
    width: 21px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
  }
  .js-menu-toggle[aria-expanded="true"] .linha-menu:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .js-menu-toggle[aria-expanded="true"] .linha-menu:nth-child(2) {
    opacity: 0;
  }
  .js-menu-toggle[aria-expanded="true"] .linha-menu:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    #header-fixo,
    .linha-menu {
      transition: none;
    }
  }
</style>

<script>
  function initHeader() {
    const topo = document.getElementById("header-topo");
    const fixo = document.getElementById("header-fixo");
    if (!topo || !fixo) return;

    const onScroll = () => {
      // O header fixo aparece só depois que o header do topo (incluindo sua
      // margem superior) saiu totalmente de vista.
      const limite = topo.offsetTop + topo.offsetHeight;
      fixo.dataset.visivel = String(window.scrollY > limite);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener(
      "astro:before-swap",
      () => window.removeEventListener("scroll", onScroll),
      { once: true },
    );
  }
  document.addEventListener("astro:page-load", initHeader);
</script>
