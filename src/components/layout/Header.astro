---
import logo from "../../assets/logo.svg?raw";
import simbolo from "../../assets/simbolo.svg?raw";
import Icone from "../ui/Icone.astro";
import NavColuna from "./NavColuna.astro";
import { navEsquerda, navDireita } from "../../data/navegacao";

/**
 * Dois headers:
 *  1. #header-topo — sobre o hero (transparente), rola JUNTO com a página e some.
 *     tema "claro" (texto escuro, Home) ou "escuro" (texto areia, hero vinho).
 *  2. #header-fixo — compacto (só o símbolo), fixo no topo. Fica escondido e
 *     desliza para dentro depois que o header do topo desaparece com o scroll.
 *     Sempre sólido (fundo branco, texto escuro), sem sombra.
 */
interface Props {
  tema?: "claro" | "escuro";
}
const { tema = "claro" } = Astro.props;

const setaHamburguer = "M3 6h18M3 12h18M3 18h18";
const navClasse =
  "mx-auto flex max-w-[1585px] items-center gap-10 px-6 py-5 lg:px-10";
const toggleClasse =
  "js-menu-toggle ml-auto flex size-10 items-center justify-center lg:hidden";
---

{/* Header do topo — rola junto com a página */}
<header id="header-topo" data-tema={tema} class="absolute inset-x-0 top-0 z-40">
  <nav class={navClasse} aria-label="Navegação principal">
    <NavColuna itens={navEsquerda} alinhamento="justify-start" />

    <a
      href="/"
      class="order-first flex shrink-0 items-center lg:order-none"
      aria-label="Igreja Batista Redenção — página inicial"
    >
      <Icone svg={logo} class="h-9" />
    </a>

    <NavColuna itens={navDireita} alinhamento="justify-end" />

    <button
      type="button"
      class={toggleClasse}
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <svg class="size-7" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d={setaHamburguer}
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </nav>
</header>

{/* Header fixo compacto — aparece deslizando após o header do topo sumir */}
<header
  id="header-fixo"
  class="fixed inset-x-0 top-0 z-50 bg-branco text-preto"
>
  <nav class={navClasse} aria-label="Navegação principal">
    <NavColuna itens={navEsquerda} alinhamento="justify-start" />

    <a
      href="/"
      class="order-first flex shrink-0 items-center lg:order-none"
      aria-label="Igreja Batista Redenção — página inicial"
    >
      <Icone svg={simbolo} class="size-11" />
    </a>

    <NavColuna itens={navDireita} alinhamento="justify-end" />

    <button
      type="button"
      class={toggleClasse}
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-mobile"
    >
      <svg class="size-7" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d={setaHamburguer}
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </nav>
</header>

<style>
  #header-topo {
    color: var(--color-preto);
  }
  #header-topo[data-tema="escuro"] {
    color: var(--color-areia);
  }

  /* Header fixo: escondido acima da viewport; desliza para dentro quando visível.
     Ancorado no id (especificidade alta) para vencer as utilities de forma estável. */
  #header-fixo {
    transform: translateY(-100%);
    opacity: 0;
    transition:
      transform 0.3s ease-out,
      opacity 0.3s ease-out;
  }
  #header-fixo[data-visivel="true"] {
    transform: translateY(0);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    #header-fixo {
      transition: none;
    }
  }
</style>

<script>
  function initHeader() {
    const topo = document.getElementById("header-topo");
    const fixo = document.getElementById("header-fixo");
    if (!topo || !fixo) return;

    const onScroll = () => {
      // O header fixo aparece só depois que o header do topo saiu de vista.
      fixo.dataset.visivel = String(window.scrollY > topo.offsetHeight);
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    document.addEventListener(
      "astro:before-swap",
      () => window.removeEventListener("scroll", onScroll),
      { once: true },
    );
  }
  document.addEventListener("astro:page-load", initHeader);
</script>
