---
import Icone from "../ui/Icone.astro";
import setaBaixo from "../../assets/icones/seta-baixo.svg?raw";
import type { ItemNav } from "../../data/navegacao";

/** Uma das duas colunas de navegação do header desktop. */
interface Props {
  itens: ItemNav[];
  alinhamento: "justify-start" | "justify-end";
  /** Cor do texto no hover: "sangue" (padrão), "branco" (hero vinho) ou
   * "areia" (hero com foto, texto já branco) */
  hover?: "sangue" | "branco" | "areia";
}
const { itens, alinhamento, hover = "sangue" } = Astro.props;

// Classes completas (literais) para o JIT do Tailwind gerar as variantes.
const hovers = {
  sangue: {
    link: "hover:text-sangue",
    btn: "hover:text-sangue group-hover/drop:text-sangue group-focus-within/drop:text-sangue",
  },
  branco: {
    link: "hover:text-branco",
    btn: "hover:text-branco group-hover/drop:text-branco group-focus-within/drop:text-branco",
  },
  areia: {
    link: "hover:text-areia",
    btn: "hover:text-areia group-hover/drop:text-areia group-focus-within/drop:text-areia",
  },
};
const hoverLink = hovers[hover].link;
const hoverBtn = hovers[hover].btn;

// Na coluna da direita o dropdown ancora pela direita do item (abre para
// dentro da tela); centralizado, ele estoura a borda em janelas estreitas.
const posDropdown =
  alinhamento === "justify-end" ? "right-0" : "left-1/2 -translate-x-1/2";

// Na faixa lg (1024–1279px) os links alinham ao grid do site: a coluna da
// esquerda começa na col 2 e a da direita termina na col 11 (penúltima).
// Recuo = 1 coluna + 1 gutter, com coluna = (100vw − 2×40px − 11×40px)/12.
// De xl em diante os links voltam a ocupar a largura toda do container.
const recuoLg =
  alinhamento === "justify-start"
    ? "lg:pl-[calc((100vw_-_520px)/12_+_40px)] xl:pl-0"
    : "lg:pr-[calc((100vw_-_520px)/12_+_40px)] xl:pr-0";
---

<ul
  class:list={[
    "hidden flex-1 items-center gap-8 lg:flex xl:gap-14",
    alinhamento,
    recuoLg,
  ]}
>
  {
    itens.map((item) => (
      <li class="relative">
        {item.dropdown ? (
          <div class="group/drop">
            <button
              type="button"
              class:list={[
                "flex items-center gap-1 font-ui text-[15px] font-medium transition-colors duration-300",
                hoverBtn,
              ]}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.rotulo}
              <Icone
                svg={setaBaixo}
                class="size-6 transition-transform duration-300 group-hover/drop:rotate-180"
              />
            </button>
            <div
              class:list={[
                "invisible absolute top-full pt-3 opacity-0 transition-all duration-300 group-focus-within/drop:visible group-focus-within/drop:opacity-100 group-hover/drop:visible group-hover/drop:opacity-100",
                posDropdown,
              ]}
            >
              <ul class="flex min-w-[240px] flex-col gap-1.5 rounded-lg border border-preto/10 bg-branco p-2 shadow-[0_37px_18px_rgba(111,110,103,0.09),0_9px_10px_rgba(111,110,103,0.1)]">
                {item.dropdown.map((sub) => (
                  <li>
                    <a
                      href={sub.href}
                      class="flex items-center gap-3 rounded-md py-4 pr-6 pl-4 font-ui text-[15px] font-medium whitespace-nowrap text-preto transition-colors duration-300 hover:bg-sangue/10 hover:text-sangue"
                    >
                      {sub.icone && <Icone svg={sub.icone} class="size-6" />}
                      {sub.rotulo}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              "font-ui text-[15px] font-medium transition-colors duration-300",
              hoverLink,
            ]}
          >
            {item.rotulo}
          </a>
        )}
      </li>
    ))
  }
</ul>
