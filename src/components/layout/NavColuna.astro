---
import Icone from "../ui/Icone.astro";
import setaBaixo from "../../assets/icones/seta-baixo.svg?raw";
import type { ItemNav } from "../../data/navegacao";

/** Uma das duas colunas de navegação do header desktop. */
interface Props {
  itens: ItemNav[];
  alinhamento: "justify-start" | "justify-end";
  /** Cor do texto no hover: "sangue" (padrão) ou "branco" (header sobre o hero vinho) */
  hover?: "sangue" | "branco";
}
const { itens, alinhamento, hover = "sangue" } = Astro.props;

// Classes completas (literais) para o JIT do Tailwind gerar as variantes.
const hoverLink =
  hover === "branco" ? "hover:text-branco" : "hover:text-sangue";
const hoverBtn =
  hover === "branco"
    ? "hover:text-branco group-hover/drop:text-branco group-focus-within/drop:text-branco"
    : "hover:text-sangue group-hover/drop:text-sangue group-focus-within/drop:text-sangue";

// Na coluna da direita o dropdown ancora pela direita do item (abre para
// dentro da tela); centralizado, ele estoura a borda em janelas estreitas.
const posDropdown =
  alinhamento === "justify-end" ? "right-0" : "left-1/2 -translate-x-1/2";
---

<ul
  class:list={[
    "hidden flex-1 items-center gap-8 lg:flex xl:gap-14",
    alinhamento,
  ]}
>
  {
    itens.map((item) => (
      <li class="relative">
        {item.dropdown ? (
          <div class="group/drop">
            <button
              type="button"
              class:list={[
                "flex items-center gap-1 font-ui text-[15px] font-medium transition-colors",
                hoverBtn,
              ]}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.rotulo}
              <Icone
                svg={setaBaixo}
                class="size-6 transition-transform duration-300 group-hover/drop:rotate-180"
              />
            </button>
            <div
              class:list={[
                "invisible absolute top-full pt-3 opacity-0 transition-all duration-200 group-focus-within/drop:visible group-focus-within/drop:opacity-100 group-hover/drop:visible group-hover/drop:opacity-100",
                posDropdown,
              ]}
            >
              <ul class="flex min-w-[240px] flex-col gap-1.5 rounded-lg border border-preto/10 bg-branco p-2 shadow-[0_37px_18px_rgba(111,110,103,0.09),0_9px_10px_rgba(111,110,103,0.1)]">
                {item.dropdown.map((sub) => (
                  <li>
                    <a
                      href={sub.href}
                      class="flex items-center gap-3 rounded-md py-4 pr-6 pl-4 font-ui text-[15px] font-medium whitespace-nowrap text-preto transition-colors hover:bg-sangue/10 hover:text-sangue"
                    >
                      <Icone svg={sub.icone} class="size-6" />
                      {sub.rotulo}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              "font-ui text-[15px] font-medium transition-colors",
              hoverLink,
            ]}
          >
            {item.rotulo}
          </a>
        )}
      </li>
    ))
  }
</ul>
