---
import logo from "../../assets/logo.svg?raw";
import Icone from "../ui/Icone.astro";
import instagram from "../../assets/icones/instagram.svg?raw";
import youtube from "../../assets/icones/youtube.svg?raw";
import spotify from "../../assets/icones/spotify.svg?raw";
import email from "../../assets/icones/email.svg?raw";
import whatsapp from "../../assets/icones/whatsapp.svg?raw";
import setaDireita from "../../assets/icones/seta-direita.svg?raw";
import { contato, navEsquerda, navDireita } from "../../data/navegacao";

// Mesmos itens da barra de navegação (fonte única em navegacao.ts).
// Dropdowns apontam para o primeiro subitem. Âncoras ficam relativas
// ("#agenda"): as seções Agenda/Onde Estamos se repetem nas páginas.
const links = [...navEsquerda, ...navDireita].map((item) => ({
  rotulo: item.rotulo,
  href: item.href ?? item.dropdown?.[0].href ?? "/",
}));

const redes = [
  { rotulo: "Instagram", href: contato.instagram, icone: instagram },
  { rotulo: "Youtube", href: contato.youtube, icone: youtube },
  { rotulo: "Spotify", href: contato.spotify, icone: spotify },
];

// Frase de encerramento (Sl 90.17). Cada trecho é um bloco: no desktop cada
// um cabe numa linha (quebras nos ponto-e-vírgulas); no mobile quebram
// internamente, como no design.
const fraseFinal = {
  linhas: [
    "Seja sobre nós a graça do Senhor, nosso Deus;",
    "e confirma sobre nós a obra das nossas mãos;",
    "sim, confirma a obra das nossas mãos.",
  ],
  referencia: "Salmos 90.17",
};

const { endereco } = contato;
---

<footer class="relative overflow-hidden bg-sangue text-branco">
  <div class="mx-auto max-w-[1585px] px-6 pt-16 pb-10 lg:px-10 lg:pt-20">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      {/* Marca + redes sociais */}
      <div class="flex flex-col gap-8">
        <Icone svg={logo} class="h-12 w-auto text-branco [&>svg]:w-auto" />
        <ul class="flex flex-col gap-6">
          {
            redes.map((rede) => (
              <li>
                <a
                  href={rede.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 font-ui text-base font-medium transition-opacity hover:opacity-75"
                >
                  <Icone svg={rede.icone} class="size-6 text-areia" />
                  {rede.rotulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Links */}
      <nav aria-label="Rodapé" class="flex flex-col gap-8">
        <p class="font-sans text-lg font-semibold text-areia uppercase">
          Links
        </p>
        <ul class="flex flex-col gap-4">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="font-ui text-base font-medium transition-opacity hover:opacity-75"
                >
                  {link.rotulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Fale conosco */}
      <div class="flex flex-col gap-8">
        <p class="font-sans text-lg font-semibold text-areia uppercase">
          Fale conosco
        </p>
        <a
          href={contato.whatsapp.href}
          class="flex items-center gap-2 font-ui text-base font-medium break-all transition-opacity hover:opacity-75"
        >
          <Icone svg={whatsapp} class="size-6 shrink-0 text-areia" />
          {contato.whatsapp.placeholder}
        </a>
        <a
          href={`mailto:${contato.email}`}
          class="flex items-center gap-2 font-ui text-base font-medium break-all transition-opacity hover:opacity-75"
        >
          <Icone svg={email} class="size-6 shrink-0 text-areia" />
          {contato.email}
        </a>
      </div>

      {/* Endereço */}
      <div class="flex flex-col gap-8">
        <p class="font-sans text-lg font-semibold text-areia uppercase">
          Endereço
        </p>
        <div class="flex flex-col gap-4">
          <address class="flex flex-col text-base not-italic">
            <span class="font-sans font-semibold">{endereco.nome}</span>
            <span class="font-sans">{endereco.rua}</span>
            <span class="font-sans">{endereco.bairro}</span>
            <span class="font-sans">{endereco.cidade}</span>
          </address>
          <a
            href={contato.rotaGoogleMaps}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1 font-ui text-base font-semibold text-areia transition-opacity hover:opacity-75"
          >
            Ver rota no Google Maps
            <Icone svg={setaDireita} class="size-6" />
          </a>
        </div>
      </div>
    </div>

    <hr class="my-20 border-preto/20 lg:my-24" />

    {
      /* Frase de encerramento — base no Figma (nós 170:3877 / 170:4061):
        mobile com fluxo natural; a partir de md, 3 linhas quebrando nos
        ponto-e-vírgulas, com a fonte escalando até 50.8px (o clamp acompanha
        a largura útil até a caixa de 900px caber);
        referência em Work Sans Medium uppercase 14px/18px. */
    }
    <div
      class="flex flex-col items-center gap-6 text-center text-sangue-profundo"
    >
      <p
        class="font-display text-[2rem] leading-[0.98] font-light md:max-w-[900px] md:text-[clamp(1rem,calc(5.64vw_-_0.17rem),3.175rem)] md:leading-[1.03]"
      >
        {
          fraseFinal.linhas.map((linha) => (
            <span class="md:block">{linha} </span>
          ))
        }
      </p>
      <p class="font-sans text-sm font-medium uppercase md:text-[18px]">
        {fraseFinal.referencia}
      </p>
    </div>

    <div
      class="mt-20 flex flex-col items-center gap-4 text-center font-sans text-sm text-sangue-profundo"
    >
      <p>
        <span class="block sm:inline">
          Igreja Batista Redenção © {new Date().getFullYear()}.{" "}
        </span>
        <span class="block sm:inline">Todos os direitos reservados.</span>
      </p>
      <a
        href="/politica-de-privacidade"
        class="underline decoration-sangue-profundo/40 underline-offset-2 transition-colors hover:text-areia"
      >
        Política de Privacidade
      </a>
    </div>
  </div>
</footer>
