---
import logo from "../../assets/logo.svg?raw";
import Icone from "../ui/Icone.astro";
import instagram from "../../assets/icones/instagram.svg?raw";
import youtube from "../../assets/icones/youtube.svg?raw";
import spotify from "../../assets/icones/spotify.svg?raw";
import email from "../../assets/icones/email.svg?raw";
import whatsapp from "../../assets/icones/whatsapp.svg?raw";
import setaDireita from "../../assets/icones/seta-direita.svg?raw";
import { contato } from "../../data/navegacao";

const links = [
  { rotulo: "Missão", href: "/#missao" },
  { rotulo: "Documentos de Fé", href: "/confissao-de-fe" },
  { rotulo: "Nossa História", href: "/nossa-historia" },
  { rotulo: "Agenda", href: "/#agenda" },
  { rotulo: "Onde Estamos", href: "/#onde-estamos" },
  { rotulo: "Recursos", href: "/recursos/youtube" },
];

const redes = [
  { rotulo: "Instagram", href: contato.instagram, icone: instagram },
  { rotulo: "Youtube", href: contato.youtube, icone: youtube },
  { rotulo: "Spotify", href: contato.spotify, icone: spotify },
];

const { endereco } = contato;
---

<footer class="relative overflow-hidden bg-sangue text-branco">
  <div class="mx-auto max-w-[1585px] px-6 pt-16 pb-10 lg:px-10 lg:pt-20">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      {/* Marca + redes sociais */}
      <div class="flex flex-col gap-8">
        <Icone svg={logo} class="h-12 w-auto text-branco [&>svg]:w-auto" />
        <ul class="flex flex-col gap-6">
          {
            redes.map((rede) => (
              <li>
                <a
                  href={rede.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 font-ui text-base font-medium transition-opacity hover:opacity-75"
                >
                  <Icone svg={rede.icone} class="size-6 text-areia" />
                  {rede.rotulo}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Links */}
      <nav aria-label="Rodapé" class="flex flex-col gap-8">
        <p class="font-sans text-lg font-semibold text-areia uppercase">
          Links
        </p>
        <ul class="flex flex-col gap-4">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="font-ui text-base font-medium transition-opacity hover:opacity-75"
                >
                  {link.rotulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Fale conosco */}
      <div class="flex flex-col gap-8">
        <p class="font-sans text-lg font-semibold text-areia uppercase">
          Fale conosco
        </p>
        <a
          href={contato.whatsapp.href}
          class="flex items-center gap-2 font-ui text-base font-medium break-all transition-opacity hover:opacity-75"
        >
          <Icone svg={whatsapp} class="size-6 shrink-0 text-areia" />
          {contato.whatsapp.placeholder}
        </a>
        <a
          href={`mailto:${contato.email}`}
          class="flex items-center gap-2 font-ui text-base font-medium break-all transition-opacity hover:opacity-75"
        >
          <Icone svg={email} class="size-6 shrink-0 text-areia" />
          {contato.email}
        </a>
      </div>

      {/* Endereço */}
      <div class="flex flex-col gap-8">
        <p class="font-sans text-lg font-semibold text-areia uppercase">
          Endereço
        </p>
        <div class="flex flex-col gap-4">
          <address class="flex flex-col text-base not-italic">
            <span class="font-sans font-semibold">{endereco.nome}</span>
            <span class="font-sans">{endereco.rua}</span>
            <span class="font-sans">{endereco.bairro}</span>
            <span class="font-sans">{endereco.cidade}</span>
          </address>
          <a
            href={contato.rotaGoogleMaps}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1 font-ui text-base font-semibold text-areia transition-opacity hover:opacity-75"
          >
            Ver rota no Google Maps
            <Icone svg={setaDireita} class="size-6" />
          </a>
        </div>
      </div>
    </div>

    <hr class="mt-20 mb-16 border-preto/20 lg:mt-24 lg:mb-20" />

    {
      /*
      Frase de destaque — texto em curvas (Forevs) exportado como SVG, em duas
      versões (grande/pequena). Arquivos esperados em public/:
        - frase-salvacao.svg        (telas grandes)
        - frase-salvacao-mobile.svg (telas pequenas)
      Cor do traçado/preenchimento: sangue-escuro (#6A2429).
    */
    }
    <picture>
      <source media="(max-width: 640px)" srcset="/frase-salvacao-mobile.svg" />
      <img
        src="/frase-salvacao.svg"
        alt="Ao Senhor pertence a salvação — Jonas 2.9"
        loading="lazy"
        class="block w-full"
      />
    </picture>

    <p class="mt-10 text-center text-sm text-sangue-escuro">
      Igreja Batista Redenção © {new Date().getFullYear()}. Todos os direitos
      reservados.
    </p>
  </div>
</footer>
