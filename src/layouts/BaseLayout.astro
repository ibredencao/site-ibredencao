---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/work-sans";
import "@fontsource-variable/bitter";
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import MenuMobile from "../components/layout/MenuMobile.astro";
import Footer from "../components/layout/Footer.astro";
import { fraseIdentidade } from "../data/conteudo";

interface Props {
  title: string;
  description?: string;
  /** Tema inicial do header: "claro" sobre fundo claro (Home), "escuro"
   * sobre hero vinho, "foto" sobre hero com foto de fundo */
  temaHeader?: "claro" | "escuro" | "foto";
}

const {
  title,
  description = `Igreja Batista Redenção — ${fraseIdentidade}`,
  temaHeader = "claro",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    {
      /* Marca que há JS antes da pintura — habilita os efeitos de reveal sem risco de sumir conteúdo */
    }
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#EFECE1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Igreja Batista Redenção" />
    <meta property="og:locale" content="pt_BR" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <Header tema={temaHeader} />
    <MenuMobile />
    <main>
      <slot />
    </main>
    <Footer />
    <script src="../scripts/smooth-scroll.ts"></script>
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/barra-carregamento.ts"></script>
  </body>
</html>
