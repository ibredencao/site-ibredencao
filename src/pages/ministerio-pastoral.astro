---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroInterno from "../components/sections/HeroInterno.astro";
import MoldemImagem from "../components/ui/MoldemImagem.astro";
import Agenda from "../components/sections/Agenda.astro";
import OndeEstamos from "../components/sections/OndeEstamos.astro";
import fotoPastor from "../assets/filipe-ribeiro.jpg";

// TODO(conteúdo): o primeiro parágrafo é real; os demais são lorem do Figma.
// Substituir quando o usuário fornecer o texto definitivo, junto com as
// fotos (primeira 4:5, segunda 16:9) via MoldemImagem src.
const paragrafosIntro: string[] = [
  "Filipe Ribeiro é pastor da Igreja Batista Redenção. É bacharel em Teologia pelo Seminário Teológico Batista do Sul do Brasil e também serve na Pro Nobis Editora. Casado com Tacyla, é pai de quatro filhos: Cecília, Tito, Teodoro e Tomás.",
  "Maecenas eget condimentum velit, sit amet feugiat lectus. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos.",
];

const paragrafoLargo =
  "Sed dignissim, metus nec fringilla accumsan, risus sem sollicitudin lacus, ut interdum tellus elit sed risus. Maecenas eget condimentum velit, sit amet feugiat lectus. Class aptent taciti sociosqu ad litora torquent per conubia nostra, per inceptos himenaeos. Praesent auctor purus luctus enim egestas, ac scelerisque ante pulvinar. Donec ut rhoncus ex. Suspendisse ac rhoncus nisl, eu tempor urna. Curabitur vel bibendum lorem. Morbi convallis convallis diam sit amet lacinia. Aliquam in elementum tellus.";
---

<BaseLayout
  title="Ministério Pastoral | Igreja Batista Redenção"
  description="O ministério pastoral da Igreja Batista Redenção — Pr. Filipe Ribeiro."
  temaHeader="escuro"
>
  <HeroInterno titulo="Ministério Pastoral" />

  <section class="bg-branco py-16 lg:py-24">
    <div
      class="mx-auto grid max-w-[1585px] gap-y-10 px-6 lg:grid-cols-12 lg:gap-x-10 lg:px-10"
    >
      {
        /* Bio à esquerda, primeira foto (4:5) à direita. Título, foto e texto
          são itens separados do grid: no mobile empilham como título → foto →
          texto; no desktop a foto ocupa a coluna da direita nas duas linhas. */
      }
      <h2
        class="font-display text-[clamp(1.75rem,3vw,2.7rem)] leading-tight font-light text-bege lg:col-span-3 lg:col-start-4 lg:row-start-1"
        data-reveal
      >
        Pastor
      </h2>
      <div
        class="lg:col-span-3 lg:col-start-7 lg:row-span-2 lg:row-start-1"
        data-reveal
      >
        <MoldemImagem
          src={fotoPastor}
          alt="Pr. Filipe Ribeiro, pastor da Igreja Batista Redenção"
          proporcao="4/5"
          class="w-full"
        />
      </div>
      <div
        class="flex flex-col gap-6 font-sans text-lg leading-snug lg:col-span-3 lg:col-start-4 lg:row-start-2"
        data-reveal
      >
        {paragrafosIntro.map((p) => <p>{p}</p>)}
      </div>

      {
        /* Parágrafo largo + segunda foto (16:9), atravessando as duas colunas */
      }
      <p
        class="font-sans text-lg leading-snug lg:col-span-6 lg:col-start-4"
        data-reveal
      >
        {paragrafoLargo}
      </p>
      <div class="lg:col-span-6 lg:col-start-4" data-reveal>
        <MoldemImagem proporcao="16/9" class="w-full" />
      </div>
    </div>
  </section>

  <Agenda />
  <OndeEstamos />
</BaseLayout>
