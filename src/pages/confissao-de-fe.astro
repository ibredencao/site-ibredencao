---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroInterno from "../components/sections/HeroInterno.astro";
import Agenda from "../components/sections/Agenda.astro";
import OndeEstamos from "../components/sections/OndeEstamos.astro";
import Icone from "../components/ui/Icone.astro";
import setaBaixo from "../assets/icones/seta-baixo.svg?raw";
import { artigosConfissao, notaConfissao } from "../data/confissao";
import versiculos from "../data/versiculos-confissao.json";

/**
 * Referências → segmentos com popover de versículo (gerados por
 * scripts/gerar-versiculos.mjs). Item fora do mapa vira texto simples.
 */
interface SegmentoRef {
  rotulo: string;
  id?: string;
}
const itensVersiculos: Record<string, SegmentoRef[]> = versiculos.itens;
const segmentosDe = (item: string): SegmentoRef[] =>
  itensVersiculos[item] ?? [{ rotulo: item.replace(/\.$/, "") }];

const classeRefBotao =
  "cursor-default underline decoration-dotted decoration-preto/25 underline-offset-2 transition-colors duration-300 hover:text-sangue focus-visible:text-sangue";

// const subtitulo =
//   '"Antes, reverenciai a Cristo como Senhor no coração. Estai sempre preparados para responder a todo o que vos pedir a razão da esperança que há em vós." (1Pe 3.15)';
---

<BaseLayout
  title="Confissão de Fé | Igreja Batista Redenção"
  description="A Confissão de Fé da Igreja Batista Redenção — Confissão de Fé de New Hampshire."
  temaHeader="escuro"
>
  <HeroInterno titulo="Confissão de Fé" />

  <div class="bg-branco pb-16 lg:py-24">
    <div
      class="mx-auto grid max-w-[1585px] gap-y-12 px-6 lg:grid-cols-12 lg:gap-x-10 lg:px-10"
    >
      {
        /* Índice — no mobile é um acordeão fechado; no desktop, barra lateral fixa */
      }
      <aside
        class="sticky top-[76px] z-30 -mx-6 lg:top-28 lg:z-auto lg:col-span-3 lg:col-start-1 lg:mx-0 lg:self-start"
      >
        <details
          id="indice-confissao"
          class="group border-b border-preto/10 bg-creme lg:border-0 lg:bg-transparent"
        >
          <summary
            class="text-md flex cursor-pointer list-none items-center justify-between gap-2 px-6 py-4 font-sans font-semibold text-preto uppercase lg:pointer-events-none lg:p-0 lg:text-xl lg:font-medium lg:normal-case"
          >
            Índice
            <Icone
              svg={setaBaixo}
              class="size-6 shrink-0 transition-transform duration-300 group-open:rotate-180 lg:hidden"
            />
          </summary>
          {
            /* data-lenis-prevent: deixa a rolagem nativa do índice expandido
              funcionar no mobile (sem ele o Lenis captura o wheel). */
          }
          <nav
            aria-label="Índice da Confissão de Fé"
            class="px-6 pb-5 lg:mt-6 lg:p-0"
            data-lenis-prevent
          >
            <ol class="flex flex-col gap-2">
              {
                artigosConfissao.map((a) => (
                  <li>
                    <a
                      href={`#${a.slug}`}
                      class="font-ui text-base leading-0! opacity-70 transition-colors hover:text-sangue hover:opacity-100"
                    >
                      {a.titulo}
                    </a>
                  </li>
                ))
              }
              <li>
                <a
                  href="#nota"
                  class="font-sans text-base transition-colors hover:text-sangue"
                >
                  Nota
                </a>
              </li>
            </ol>
          </nav>
        </details>
      </aside>

      {/* Artigos */}
      <div class="flex flex-col gap-16 lg:col-span-6 lg:col-start-5">
        {
          artigosConfissao.map((artigo) => (
            <article
              id={artigo.slug}
              class="flex scroll-mt-40 flex-col gap-8 lg:scroll-mt-28"
              data-reveal
            >
              <h2 class="font-display text-[clamp(1.75rem,3vw,2.7rem)] leading-tight font-light text-bege">
                {artigo.num}. {artigo.titulo}
              </h2>
              <div class="flex flex-col gap-6">
                {artigo.blocos.map((bloco) =>
                  bloco.tipo === "p" ? (
                    <p class="font-sans text-lg leading-snug">{bloco.texto}</p>
                  ) : (
                    <ol class="flex list-decimal flex-col gap-1 pl-6 text-sm text-preto/50">
                      {bloco.itens?.map((ref) => (
                        <li>
                          <span class="leading-snug">
                            {segmentosDe(ref).map((seg, i) => (
                              <>
                                {i > 0 && "; "}
                                {seg.id ? (
                                  <button
                                    type="button"
                                    class={classeRefBotao}
                                    data-versiculo={seg.id}
                                  >
                                    {seg.rotulo}
                                  </button>
                                ) : (
                                  seg.rotulo
                                )}
                              </>
                            ))}
                            .
                          </span>
                        </li>
                      ))}
                    </ol>
                  ),
                )}
              </div>
            </article>
          ))
        }

        {/* Nota */}
        <article
          id="nota"
          class="flex scroll-mt-40 flex-col gap-6 border-t border-preto/10 pt-12 lg:scroll-mt-28"
        >
          <h2 class="font-display text-2xl font-normal text-preto">Nota</h2>
          {
            notaConfissao.map((bloco) =>
              bloco.tipo === "p" ? (
                <p class="text-justify font-sans text-base text-preto">
                  {bloco.texto}
                </p>
              ) : (
                <ol class="flex list-decimal flex-col gap-1 pl-6 text-sm text-preto/40">
                  {bloco.itens?.map((ref) => (
                    <li>
                      {segmentosDe(ref).map((seg, i) => (
                        <>
                          {i > 0 && "; "}
                          {seg.id ? (
                            <button
                              type="button"
                              class={classeRefBotao}
                              data-versiculo={seg.id}
                            >
                              {seg.rotulo}
                            </button>
                          ) : (
                            seg.rotulo
                          )}
                        </>
                      ))}
                      .
                    </li>
                  ))}
                </ol>
              ),
            )
          }
        </article>
      </div>
    </div>
  </div>

  <Agenda />
  <OndeEstamos />
</BaseLayout>

<script src="../scripts/versiculos.ts"></script>

<script>
  // Ao clicar num tópico do índice, fecha o acordeão (mobile) para não tapar
  // o conteúdo. No desktop o CSS mantém a lista visível de qualquer forma.
  function initIndice() {
    const indice = document.getElementById("indice-confissao");
    if (!indice) return;
    indice.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        indice.open = false;
      }),
    );
  }
  document.addEventListener("astro:page-load", initIndice);
</script>

<style>
  /* No mobile, o índice expandido tem rolagem própria (limitada ao espaço
     abaixo do header fixo de 76px + barra "Índice" de 56px, com folga),
     sem scrollbar visível e sem propagar a rolagem para a página. */
  @media (max-width: 1023px) {
    #indice-confissao > nav {
      max-height: calc(100vh - 152px);
      max-height: calc(100dvh - 152px);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
    #indice-confissao > nav::-webkit-scrollbar {
      display: none;
    }
  }

  /* No desktop o índice fica sempre visível (barra lateral), ignorando o
     estado aberto/fechado do <details> que controla o acordeão no mobile.
     Em telas baixas a lista ganha rolagem própria (limitada ao espaço abaixo
     do sticky top-28 de 112px + título de 28px + mt-6 de 24px, com folga),
     sem scrollbar visível, para os últimos links não ficarem engolidos. */
  @media (min-width: 1024px) {
    #indice-confissao > nav {
      display: block;
      max-height: calc(100vh - 188px);
      max-height: calc(100dvh - 188px);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
    #indice-confissao > nav::-webkit-scrollbar {
      display: none;
    }
    #indice-confissao::details-content {
      content-visibility: visible;
    }
  }
</style>
