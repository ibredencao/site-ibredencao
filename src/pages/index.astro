---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Igreja Batista Redenção">
  <main
    class="flex min-h-screen flex-col items-center justify-center gap-10 px-6 text-center"
  >
    <h1 class="max-w-3xl font-display text-5xl leading-tight font-light">
      Firmada no evangelho, dedicada ao discipulado e à glória de Deus.
    </h1>
    <div class="flex items-center gap-5">
      <span
        class="rounded-lg bg-sangue px-8 py-6 font-ui text-[15px] font-semibold text-branco"
      >
        Onde estamos
      </span>
      <span
        class="rounded-lg border border-sangue px-8 py-6 font-ui text-[15px] font-semibold text-sangue"
      >
        Confissão de fé
      </span>
    </div>
    <p class="text-sm text-preto/60">
      Scaffold inicial — as páginas do Figma entram em seguida.
    </p>
  </main>
</BaseLayout>
