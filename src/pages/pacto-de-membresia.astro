---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroInterno from "../components/sections/HeroInterno.astro";
import Agenda from "../components/sections/Agenda.astro";
import OndeEstamos from "../components/sections/OndeEstamos.astro";
import { pactoDeMembresia } from "../data/conteudo";

// TODO(conteúdo): o Pacto de Membresia não tem frame no Figma nem texto definido.
// Quando a igreja fornecer o texto, estruturá-lo como em src/data/confissao.ts
// (ou Markdown) e renderizar aqui no mesmo padrão da Confissão de Fé.
---

<BaseLayout
  title="Pacto de Membresia | Igreja Batista Redenção"
  description="O Pacto de Membresia da Igreja Batista Redenção."
  temaHeader="escuro"
>
  <HeroInterno titulo="Pacto de Membresia" />

  <section class="bg-branco py-20 lg:py-28">
    <div
      class="mx-auto flex max-w-3xl flex-col gap-6 px-6 lg:px-10"
      data-reveal
    >
      {
        pactoDeMembresia.map((p) => (
          <p class="font-sans text-lg leading-snug opacity-80">{p}</p>
        ))
      }
    </div>
  </section>

  <Agenda />
  <OndeEstamos />
</BaseLayout>
