---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroInterno from "../components/sections/HeroInterno.astro";
import Agenda from "../components/sections/Agenda.astro";
import OndeEstamos from "../components/sections/OndeEstamos.astro";
import { introPacto, pactoDeMembresia } from "../data/conteudo";
---

<BaseLayout
  title="Pacto de Membresia | Igreja Batista Redenção"
  description="O Pacto de Membresia da Igreja Batista Redenção."
  temaHeader="escuro"
>
  <HeroInterno titulo="Pacto de Membresia" />

  <section class="bg-branco py-20 lg:py-28">
    <div class="mx-auto flex max-w-3xl flex-col gap-12 px-6 lg:px-10">
      {/* Preâmbulo — mesmo desenho do da Confissão de Fé */}
      <article
        class="flex flex-col gap-6 border-b border-preto/10 pb-12"
        data-reveal
      >
        <h2 class="font-display text-2xl font-normal text-preto">
          {introPacto.titulo}
        </h2>
        {
          introPacto.paragrafos.map((p) => (
            <p class="font-sans text-base text-preto">{p}</p>
          ))
        }
      </article>

      <div class="flex flex-col gap-6" data-reveal>
        {
          pactoDeMembresia.map((p) => (
            <p class="font-sans text-lg leading-relaxed">{p}</p>
          ))
        }
      </div>
    </div>
  </section>

  <Agenda />
  <OndeEstamos />
</BaseLayout>
