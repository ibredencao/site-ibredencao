---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroInterno from "../components/sections/HeroInterno.astro";
import MoldemImagem from "../components/ui/MoldemImagem.astro";
import Agenda from "../components/sections/Agenda.astro";
import OndeEstamos from "../components/sections/OndeEstamos.astro";
import { blocosHistoria } from "../data/historia";
import fotoPequenoGrupo from "../assets/historia-pequeno-grupo.jpg";
import fotoPrimeiroCulto from "../assets/historia-primeiro-culto.jpg";
import fotoBatismo from "../assets/historia-batismo.jpg";
import fotoIgrejaReunida from "../assets/historia-igreja-reunida.jpg";
import fotoEspacoAtual from "../assets/historia-espaco-atual.jpg";

/**
 * Nossa História: blocos de texto intercalados com fotos (16:9), na ordem
 * da narrativa — pequeno grupo, primeiro culto, batismo, igreja reunida —
 * e, fechando a página, o culto no espaço atual. A foto i fecha o bloco i.
 */
const fotos = [
  {
    src: fotoPequenoGrupo,
    alt: "Pequeno grupo reunido em uma sala de apartamento, cantando durante o culto doméstico",
  },
  {
    src: fotoPrimeiroCulto,
    alt: "Congregação reunida em oração durante culto da Igreja Batista Redenção",
  },
  {
    src: fotoBatismo,
    alt: "Pr. Filipe Ribeiro celebrando o batismo de um irmão",
  },
  {
    src: fotoIgrejaReunida,
    alt: "Membros da Igreja Batista Redenção reunidos em confraternização",
  },
  {
    src: fotoEspacoAtual,
    alt: "Igreja reunida em culto no espaço atual, na Av. Prudente de Morais",
  },
];
---

<BaseLayout
  title="Nossa História | Igreja Batista Redenção"
  description="A história da Igreja Batista Redenção: da visão missionária que a plantou ao que Deus segue fazendo em Natal/RN."
  temaHeader="escuro"
>
  <HeroInterno titulo="Nossa História" />

  <section class="bg-branco py-20 lg:py-28">
    <div class="mx-auto flex max-w-3xl flex-col gap-12 px-6 lg:px-10">
      {
        blocosHistoria.map((bloco, i) => (
          <>
            <div
              class="flex flex-col gap-6 font-sans text-lg leading-relaxed"
              data-reveal
            >
              {bloco.paragrafos.map((p) => (
                <p>{p}</p>
              ))}
            </div>
            {fotos[i] && (
              <div data-reveal>
                <MoldemImagem
                  src={fotos[i].src}
                  alt={fotos[i].alt}
                  proporcao="16/9"
                  class="w-full"
                />
              </div>
            )}
          </>
        ))
      }
    </div>
  </section>

  <Agenda />
  <OndeEstamos />
</BaseLayout>
