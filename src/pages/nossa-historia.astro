---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroInterno from "../components/sections/HeroInterno.astro";
import MoldemImagem from "../components/ui/MoldemImagem.astro";
import Agenda from "../components/sections/Agenda.astro";
import OndeEstamos from "../components/sections/OndeEstamos.astro";
import { blocosHistoria, fechoHistoria } from "../data/historia";

/**
 * Nossa História: blocos de texto intercalados com fotos (16:10).
 * TODO(fotos): trocar os placeholders pelas fotos reais quando chegarem —
 * sugestão por posição: 1) família pastoral / envio; 2) primeiro culto ou
 * batismos; 3) igreja reunida no espaço atual. O último bloco fecha sem
 * foto, com o "Soli Deo Gloria." em destaque.
 */
---

<BaseLayout
  title="Nossa História | Igreja Batista Redenção"
  description="A história da Igreja Batista Redenção: da visão missionária que a plantou ao que Deus segue fazendo em Natal/RN."
  temaHeader="escuro"
>
  <HeroInterno titulo="Nossa História" />

  <section class="bg-branco py-20 lg:py-28">
    <div class="mx-auto flex max-w-3xl flex-col gap-12 px-6 lg:px-10">
      {
        blocosHistoria.map((bloco, i) => (
          <>
            <div
              class="flex flex-col gap-6 font-sans text-lg leading-relaxed"
              data-reveal
            >
              {bloco.paragrafos.map((p) => (
                <p>{p}</p>
              ))}
            </div>
            {i < blocosHistoria.length - 1 && (
              <div data-reveal>
                <MoldemImagem proporcao="16/10" class="w-full" />
              </div>
            )}
          </>
        ))
      }

      <p class="font-display text-2xl text-bege lg:text-3xl" data-reveal>
        {fechoHistoria}
      </p>
    </div>
  </section>

  <Agenda />
  <OndeEstamos />
</BaseLayout>
